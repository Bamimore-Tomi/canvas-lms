# Optional: set a custom image name/tag for the build output
CANVAS_IMAGE_NAME=canvas-lms:coolify
POSTGRES_PASSWORD=change-me
ENCRYPTION_KEY=change-me
# Can be set later; if unset, init won't write config/domain.yml
CANVAS_DOMAIN=canvas.example.com
CANVAS_PRODUCT_NAME=Your Deployment Name
CANVAS_LMS_ADMIN_EMAIL=admin@example.com
CANVAS_LMS_ADMIN_PASSWORD=change-me
CANVAS_LMS_ACCOUNT_NAME=Your Organization
CANVAS_LMS_STATS_COLLECTION=opt_out

# Optional overrides
CANVAS_DATABASE_USERNAME=postgres
CANVAS_DATABASE_PRODUCTION=canvas_production
CANVAS_DOMAIN_SSL=true
CANVAS_FILES_DOMAIN=
